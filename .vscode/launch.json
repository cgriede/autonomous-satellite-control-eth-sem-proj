{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend${pathSeparator}${env:PYTHONPATH}"
      }
    },
    {
      "name": "Sat Sim Export",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/render/render_main.py",
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend${pathSeparator}${env:PYTHONPATH}"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": ["--save-one-pass-30x"]
    },
    {
      "name": "Sat Sim Interactive",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/render/render_main.py",
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend${pathSeparator}${env:PYTHONPATH}"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
    },
    {
      "name": "Showcase: Mission profile sample",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/environment_definition/mission_profiles/mission_1_random_fl.py",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend${pathSeparator}${env:PYTHONPATH}"
      }
    },
    {
      "name": "Sat Sim: camera observation (headless)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/scripts/print_camera_observation_line.py",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": ["--stride", "1", "--num-frames", "500"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend${pathSeparator}${env:PYTHONPATH}"
      }
    },
    {
      "name": "MPO: Train satellite agent",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/scripts/train_sat_agent.py",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": ["--seed", "0", "--train-episodes", "20", "--warmup-episodes", "0"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend${pathSeparator}${env:PYTHONPATH}"
      }
    },
    {
      "name": "MPO: Eval satellite agent",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/scripts/eval_sat_agent.py",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": [
        "--checkpoint",
        "${workspaceFolder}/backend/autonomous_control/models/REPLACE_WITH_RUN_ID/agent.pt",
        "--eval-episodes",
        "5"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend${pathSeparator}${env:PYTHONPATH}"
      }
    }
  ]
}
