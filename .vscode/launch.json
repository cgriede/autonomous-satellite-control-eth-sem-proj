{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend${pathSeparator}${env:PYTHONPATH}"
      }
    },
    {
      "name": "Sat Sim Export",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/render/first_plot.py",
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend${pathSeparator}${env:PYTHONPATH}"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": ["--save-one-pass-30x"]
    },
    {
      "name": "Sat Sim Interactive",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/render/first_plot.py",
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend${pathSeparator}${env:PYTHONPATH}"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
    },
    {
      "name": "Showcase: Mission profile sample",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/environment_definition/mission_profiles/mission_1_random_fl.py",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend${pathSeparator}${env:PYTHONPATH}"
      }
    },
  ]
}
